module(name = "io_bazel_rules_k8s")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

bazel_dep(name = "platforms", version = "1.0.0")

# Note: rules_cc 0.2.12+ introduces cc_compatibility_proxy which causes
# "cycles detected during computation of main repo mapping" errors with Bazel 8.4.2
# Keep at 0.2.11 until compatibility issue is resolved
# https://github.com/bazelbuild/bazel/issues/27582
bazel_dep(name = "rules_cc", version = "0.2.11")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_go", version = "0.57.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "rules_pkg", version = "1.1.0")

# Pinned to the discord fork of rules_docker
bazel_dep(name = "io_bazel_rules_docker", version = "0.0.0")

bazel_dep(name = "gazelle", version = "0.45.0", repo_name = "bazel_gazelle")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.module(
    path = "google.golang.org/grpc",
    sum = "h1:C1QC6KzgSiLyBabDi87BbjaGreoRgGUF5nOyvfrAZ1k=",
    version = "v1.28.1",
)
go_deps.module(
    path = "golang.org/x/net",
    sum = "h1:h5tBRKZ1aY/bo6GNqe/4zWC8GkaLOFQ5wPKIOQ0i2sA=",
    version = "v0.0.0-20190918130420-a8b05e9114ab",
)
go_deps.module(
    path = "golang.org/x/text",
    sum = "h1:tW2bmiBqwgJj/UpqtC8EpXEZVYOwU0yG4iWbprSVAcs=",
    version = "v0.3.2",
)
go_deps.module(
    path = "golang.org/x/sys",
    sum = "h1:uYVVQ9WP/Ds2ROhcaGPeIdVq0RIXVLwsHlnvJ+cT1So=",
    version = "v0.0.0-20200302150141-5c8b2ff67527",
)
go_deps.module(
  path = "gopkg.in/yaml.v2",
  version = "v2.2.0+incompatible",
  sum = "h1:hI93XBmqTisBFMUTm0b8Fm+jr3Dg1NNxqwp+5A1VGuI=",
)
go_deps.module(
  path = "github.com/google/go-containerregistry",
  version = "v0.1.4",
  sum = "h1:fZm+V2pYnvb8NMPM1YOsyxr31XKfpHTun5oVTRnG8qc=",
)
go_deps.module(
  path = "github.com/pkg/errors",
  version = "v0.9.1",
  sum = "h1:FEBLx1zS214owpjy7qsBeixbURkuhQAwrK5UwLGTwt4=",
)
use_repo(
    go_deps,
    "org_golang_google_grpc",
    "org_golang_x_net",
    "org_golang_x_sys",
    "org_golang_x_text",
    "com_github_google_go_containerregistry",
    "com_github_pkg_errors",
    "in_gopkg_yaml_v2",
)

k8s_deps = use_extension("//:extension.bzl", "k8s_deps")
k8s_deps.all()
use_repo(k8s_deps, "com_github_yaml_pyyaml", "subpar")
